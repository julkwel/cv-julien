---
import Split from './Split.astro';
import { profile, socials } from '../data/profile';
---
<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <p class="eyebrow mono" data-reveal><span class="num">05</span> Contact</p>
    <Split id="contact-title" class="contact-title" text="Un projet en tête ? *Parlons-en.*" />

    <div class="mail-row" data-reveal style="--d:2">
      <a class="mail" href={`mailto:${profile.email}`} data-magnetic>
        <span class="mail-text">{profile.email}</span>
        <span class="mail-arrow" aria-hidden="true">↗</span>
      </a>
      <button class="btn copy" type="button" data-copy={profile.email}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="8" y="8" width="13" height="13" rx="2" /><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3" /></svg>
        <span>Copier l’adresse</span>
      </button>
    </div>

    <div class="contact-grid">
      <div class="contact-col" data-reveal style="--d:3">
        <h3 class="mono muted">Téléphone</h3>
        <a class="link-lg" href={`tel:${profile.phoneHref}`}>{profile.phone}</a>
        <h3 class="mono muted">CV</h3>
        <a class="link-lg" href={profile.cv} target="_blank" rel="noopener noreferrer">Lire mon CV <span aria-hidden="true">↗</span></a>
      </div>
      <ul class="socials" data-reveal style="--d:4" aria-label="Réseaux">
        {socials.map((s) => (
          <li>
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer me"
              aria-label={`${s.label} : profil de Julien Rajerison (${s.handle}), s’ouvre dans un nouvel onglet`}
            >
              <span class="s-label">{s.label}</span>
              <span class="s-handle mono muted">{s.handle}</span>
              <span class="s-arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }
  :global(.contact-title) {
    margin-top: 1.5rem;
    font-size: clamp(3rem, 1.2rem + 8.5vw, 10rem);
    line-height: 0.92;
    letter-spacing: -0.05em;
    max-width: 11ch;
  }
  .mail-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--line);
  }
  .mail {
    --x: 0px;
    --y: 0px;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    max-width: 100%;
    font-family: var(--font-sans);
    /* Sized so the address fits on one line down to 320px. */
    font-size: clamp(1.1rem, 0.2rem + 4.5vw, 3.6rem);
    letter-spacing: -0.03em;
    text-decoration: none;
    transform: translate(var(--x), var(--y));
    transition: transform 0.4s var(--ease-out), color 0.3s;
  }
  .mail-text {
    overflow-wrap: anywhere;
    background: linear-gradient(var(--accent) 0 0) no-repeat 0 100% / 0% 2px;
    transition: background-size 0.6s var(--ease-out);
  }
  .mail:hover .mail-text,
  .mail:focus-visible .mail-text {
    background-size: 100% 2px;
  }
  .mail-arrow {
    color: var(--accent-ink);
    transition: transform 0.5s var(--ease-out);
  }
  .mail:hover .mail-arrow {
    transform: translate(4px, -4px) rotate(45deg);
  }
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: clamp(2rem, 6vw, 6rem);
    padding-top: clamp(2.5rem, 5vw, 4rem);
  }
  .contact-col {
    display: grid;
    align-content: start;
    gap: 0.4rem;
  }
  .contact-col h3 {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }
  .contact-col h3 + a {
    margin-bottom: 1.5rem;
  }
  .link-lg {
    font-family: var(--font-sans);
    font-size: clamp(1.4rem, 1.1rem + 1vw, 2rem);
    text-decoration: none;
    justify-self: start;
    background: linear-gradient(currentColor 0 0) no-repeat 0 100% / 100% 1px;
    transition: background-size 0.4s var(--ease-out);
  }
  .link-lg:hover {
    background-size: 0 1px;
    background-position: 100% 100%;
  }
  .socials {
    border-top: 1px solid var(--line);
  }
  .socials a {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 2rem;
    align-items: center;
    gap: 1rem;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    isolation: isolate;
  }
  .socials a::before {
    content: '';
    position: absolute;
    inset: 0 -1rem;
    z-index: -1;
    border-radius: 10px;
    background: var(--accent);
    clip-path: inset(0 100% 0 0);
    transition: clip-path 0.55s var(--ease-out);
  }
  .socials a:hover::before,
  .socials a:focus-visible::before {
    clip-path: inset(0 0 0 0);
  }
  .socials a:hover,
  .socials a:focus-visible {
    color: var(--on-accent);
  }
  .socials a:hover .s-handle,
  .socials a:focus-visible .s-handle {
    color: inherit;
  }
  .s-label {
    font-family: var(--font-sans);
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2.2rem);
    transition: transform 0.5s var(--ease-out);
  }
  .socials a:hover .s-label {
    transform: translateX(0.75rem);
  }
  .s-arrow {
    justify-self: end;
    transition: transform 0.5s var(--ease-out);
  }
  .socials a:hover .s-arrow {
    transform: rotate(45deg);
  }
  @media (max-width: 760px) {
    .contact-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .s-handle {
      display: none;
    }
    .socials a {
      grid-template-columns: minmax(0, 1fr) 2rem;
    }
  }
</style>
