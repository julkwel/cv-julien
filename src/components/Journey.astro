---
import Split from './Split.astro';
import { experience } from '../data/profile';
---
<section class="section journey" id="journey" aria-labelledby="journey-title">
  <div class="wrap journey-grid">
    <div class="section-head journey-head">
      <p class="eyebrow mono" data-reveal><span class="num">02</span> Parcours</p>
      <Split id="journey-title" class="section-title" text="Du stage *au lead.*" />
      <p class="section-lede" data-reveal style="--d:2">
        Des télécoms à l’offshore, puis le freelance : chaque étape a ajouté une couche, du C# au TypeScript.
      </p>
    </div>

    <div class="timeline" id="timeline">
      <span class="tl-rail" aria-hidden="true"><span class="tl-fill"></span></span>
      <ol class="tl-list">
      {experience.map((job, i) => (
        <li class="tl-item" data-reveal data-tl>
          <span class="tl-dot" aria-hidden="true"></span>
          <div class="tl-head">
            <h3>{job.company}</h3>
            {job.period && <span class="mono tl-period">{job.period}</span>}
          </div>
          <p class="tl-role">{job.role}</p>
          {job.note && <p class="muted">{job.note}</p>}
          <ul class="tl-stack" aria-label={`Stack chez ${job.company}`}>
            {job.stack.map((s) => <li>{s}</li>)}
          </ul>
          {i === 0 && <span class="tl-now mono">Maintenant</span>}
        </li>
      ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .journey-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.3fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .journey-head {
    position: sticky;
    top: 7rem;
  }
  .timeline {
    --progress: 0;
    position: relative;
    margin: 0;
    padding: 0 0 0 2.5rem;
  }
  .tl-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tl-rail {
    position: absolute;
    left: 0.45rem;
    top: 0.6rem;
    bottom: 0.6rem;
    width: 1px;
    background: var(--line-2);
  }
  .tl-fill {
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform-origin: 0 0;
    transform: scaleY(var(--progress));
  }
  .tl-item {
    position: relative;
    padding-block: 1.8rem;
    border-bottom: 1px solid var(--line);
    display: grid;
    gap: 0.5rem;
  }
  .tl-item:first-of-type {
    padding-top: 0;
  }
  .tl-dot {
    position: absolute;
    left: calc(-2.5rem + 0.45rem - 5px);
    top: 2.35rem;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--bg);
    border: 1px solid var(--line-2);
    transition: background-color 0.4s, border-color 0.4s, transform 0.4s var(--ease-out);
  }
  .tl-item:first-of-type .tl-dot {
    top: 0.55rem;
  }
  .tl-item.is-lit .tl-dot {
    background: var(--accent);
    border-color: var(--accent);
    transform: scale(1.25);
  }
  .tl-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 1rem;
  }
  .tl-head h3 {
    font-size: clamp(1.8rem, 1.3rem + 1.6vw, 2.7rem);
    letter-spacing: -0.03em;
  }
  .tl-period {
    color: var(--ink-2);
  }
  .tl-role {
    font-size: 1.08rem;
  }
  .tl-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.9rem;
    margin-top: 0.4rem;
    font-family: var(--font-sans);
    font-size: 0.76rem;
    color: var(--ink-2);
  }
  .tl-stack li + li::before {
    content: '/';
    margin-right: 0.9rem;
    color: var(--ink-3);
  }
  .tl-now {
    position: absolute;
    right: 0;
    top: -2rem;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 0.72rem;
  }
  @media (max-width: 900px) {
    .journey-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .journey-head {
      position: static;
    }
    .tl-now {
      position: static;
      justify-self: start;
      order: -1;
    }
  }
</style>
