---
const links = [
  { href: '#about', label: 'À propos' },
  { href: '#setup', label: 'Setup' },
  { href: '#skills', label: 'Compétences' },
  { href: '#work', label: 'Projets' },
  { href: '#journey', label: 'Parcours' },
  { href: '#contact', label: 'Contact' },
];
---
<div class="progress" aria-hidden="true"></div>
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/#top">
      <!-- Same file as the favicon (public/favicon.svg). -->
      <img class="brand-mark" src="/favicon.svg" alt="Accueil" width="36" height="36" />
    </a>
    <nav class="nav" id="nav" aria-label="Navigation principale">
      {links.map((l) => <a href={l.href} data-nav>{l.label}</a>)}
    </nav>
    <div class="header-actions">
      <button class="icon-btn" type="button" id="theme-toggle" aria-label="Activer le thème clair">
        <svg class="theme-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <mask id="moon">
            <rect width="24" height="24" fill="#fff" />
            <circle class="moon-mask" cx="17" cy="7" r="6" fill="#000" />
          </mask>
          <circle cx="12" cy="12" r="5.2" fill="currentColor" stroke="none" mask="url(#moon)" />
          <g class="sun-rays">
            <path d="M12 1.5v2.2M12 20.3v2.2M1.5 12h2.2M20.3 12h2.2M4.6 4.6l1.5 1.5M17.9 17.9l1.5 1.5M4.6 19.4l1.5-1.5M17.9 6.1l1.5-1.5" />
          </g>
        </svg>
      </button>
      <button class="icon-btn menu-btn" type="button" id="menu-toggle" aria-expanded="false" aria-controls="nav" aria-label="Ouvrir le menu">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M2 6h14M2 12h14" />
        </svg>
      </button>
    </div>
  </div>
</header>
